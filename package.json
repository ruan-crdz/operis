{
  "name": "operis",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @operis/web dev",
    "build": "turbo build",
    "lint": "eslint .",
    "typecheck": "turbo typecheck",
    "test": "vitest run && node --test scripts/database.test.mjs",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "node scripts/generate-types.mjs",
    "fixtures": "node scripts/fixtures.mjs",
    "format": "prettier --write .",
    "test:db": "node --test scripts/database.test.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:types:supabase": "node scripts/generate-supabase-types.mjs",
    "edge:build": "node scripts/build-edge.mjs",
    "preview": "node scripts/serve-static.mjs",
    "pages:check": "node scripts/check-pages.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "latest",
    "@electric-sql/pglite": "latest",
    "@playwright/test": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "exceljs": "latest",
    "jsdom": "latest",
    "pg": "latest",
    "prettier": "latest",
    "supabase": "latest",
    "turbo": "latest",
    "typescript": "^5.9.0",
    "vitest": "latest"
  },
  "type": "module"
}
